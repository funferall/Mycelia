{
  "name": "mycelia",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Mycelia — an ecological real-time strategy game about growing a fungal network through living forest soil.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node tools/test-sim.mjs",
    "test:view": "node tools/test-view.mjs",
    "test:journey": "node tools/test-journey.mjs",
    "cf:login": "wrangler login",
    "deploy": "npm run build && wrangler pages deploy"
  },
  "dependencies": {
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright": "^1.63.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "wrangler": "^4.134.0"
  }
}
