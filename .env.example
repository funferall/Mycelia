# Copy to .env.local (git-ignored) for `npm run dev` / `vite preview`.
# In production set the same names as Cloudflare Pages secrets:
#   npx wrangler pages secret put TYPESAFE_API_KEY
# The browser never sees these; it talks to /api/decide.

# TypeSafe Jev (https://docs.typesafe.ai/api)
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# OpenAI Decisions API (limited preview; schema to confirm)
OPENAI_API_KEY=
OPENAI_DECISIONS_URL=
# OPENAI_DECISIONS_MODEL=gpt-6-luna
