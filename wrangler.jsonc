{
  // Cloudflare Pages project config. `wrangler pages deploy` reads the build
  // output directory from here, so `npm run deploy` needs no extra arguments.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mycelia",
  "compatibility_date": "2026-09-17",
  "pages_build_output_dir": "./dist"
}
